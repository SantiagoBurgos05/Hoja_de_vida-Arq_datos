# Backend (Render)
MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net
MONGO_DB=hoja_de_vida
CORS_ORIGINS=https://USUARIO.github.io
STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=            # clave de servicio: SOLO en el backend, nunca en el frontend
SUPABASE_BUCKET=certificados     # bucket PRIVADO
ADMIN_TOKEN=                     # vacío = build-gold y /api/admin/maintenance deshabilitados
ALLOWED_CONNECTOR_HOSTS=www.datos.gov.co
TRUST_PROXY=true                 # detrás de Render: IP real desde X-Forwarded-For (límites de uso)
USER_STORAGE_QUOTA_MB=25         # espacio para soportes por usuario
STALE_UPLOAD_MINUTES=60          # una carga en curso más antigua se considera interrumpida
